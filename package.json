{
  "name": "revenant",
  "version": "0.2.0",
  "description": "A stock Explorer replacement: instant whole-drive file search and directory browsing built on raw NTFS MFT indexing, plus an undo/recovery safety net.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Stam",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.stam.revenant",
    "productName": "Revenant",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "native/mftvol/build/Release/mftvol.node",
      "build/icon.ico",
      "!lib/test-index.js"
    ],
    "asarUnpack": [
      "native/mftvol/build/Release/mftvol.node"
    ]
  }
}
